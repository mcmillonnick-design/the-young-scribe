rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The Young Scribe has no user accounts of its own — kids log in with a
    // simple 4-digit PIN checked in the app's JavaScript, not through
    // Firebase Auth. That means these rules can't tell "a kid's browser"
    // apart from anyone else on the internet who happens to know your
    // Firebase project id, so they're intentionally open on just the three
    // paths this app uses (nothing else in your project is exposed).
    //
    // This is a proportionate, not bulletproof, security level for a small
    // private family app. Don't post the GitHub Pages link publicly or
    // anywhere search engines would index it, and you're fine.

    match /profiles/{profileId} {
      allow read, write: if true;
    }
    match /config/{doc} {
      allow read, write: if true;
    }
    match /meta/{doc} {
      allow read, write: if true;
    }
  }
}
